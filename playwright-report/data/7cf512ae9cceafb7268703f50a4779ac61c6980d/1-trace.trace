{"type":"frame-snapshot","snapshot":{"callId":"tlrw@67","phase":"after","pageId":"page@e3e839b1687e5f13868665ec926f1dde","frameId":"frame@427a3433ad9c348ec35be8cfc6cee3d6","frameUrl":"http://localhost:5173/login","doctype":"html","html":["HTML",{"lang":"es"},["HEAD",{},["BASE",{"href":"http://localhost:5173/login"}],"\n  ","\n\n  ","\n\n  ",["META",{"charset":"utf-8"}],"\n  ",["META",{"name":"viewport","content":"width=device-width, initial-scale=1.0"}],"\n  ",["LINK",{"rel":"icon","type":"image/jpeg","href":"/favicon.jpg"}],"\n  ",["LINK",{"rel":"preconnect","href":"https://fonts.googleapis.com"}],"\n  ",["LINK",{"rel":"preconnect","href":"https://fonts.gstatic.com","crossorigin":""}],"\n  ",["LINK",{"href":"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap","rel":"stylesheet"}],"\n  ",["TITLE",{},"Suma un plato"],"\n",["STYLE",{},"/* ---------- Tokens de animación ---------- */\n:root {\n  --ease-suave: cubic-bezier(0.22, 0.8, 0.24, 1);\n  --esq-base: color-mix(in srgb, var(--tinta-suave, #8a8a8a) 12%, transparent);\n  --esq-brillo: color-mix(in srgb, var(--tinta-suave, #8a8a8a) 24%, transparent);\n}\n\n/* ---------- Esqueleto de carga ---------- */\n.esq-lista {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n}\n\n.esq-estado {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  font-size: 14px;\n  color: var(--tinta-suave);\n  animation: aparecer 0.4s var(--ease-suave) both;\n}\n\n.esq-punto {\n  position: relative;\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: var(--naranja-hover, currentColor);\n}\n.esq-punto::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: 50%;\n  background: inherit;\n  animation: latido 1.4s var(--ease-suave) infinite;\n}\n\n.esq-tarjeta {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 20px;\n  animation: entrar 0.5s var(--ease-suave) both;\n  animation-delay: calc(var(--i, 0) * 80ms);\n}\n\n.esq-textos {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n/* Brillo que recorre todas las piezas sincronizado (background-attachment: fixed) */\n.esq {\n  background: linear-gradient(100deg, var(--esq-base) 30%, var(--esq-brillo) 50%, var(--esq-base) 70%);\n  background-size: 200vw 100%;\n  background-attachment: fixed;\n  animation: brillo 1.6s linear infinite;\n}\n.esq-circulo { width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0; }\n.esq-linea { height: 14px; border-radius: 6px; }\n.esq-linea-chica { height: 11px; }\n.esq-chip { width: 84px; height: 24px; border-radius: 999px; flex-shrink: 0; }\n\n/* ---------- Lista real ---------- */\n.lista-donaciones {\n  display: flex;\n  flex-direction: column;\n}\n\n/* El separador vive dentro del ítem para que colapse junto con él */\n.donacion-item {\n  display: grid;\n  grid-template-rows: 1fr;\n  animation: entrar 0.5s var(--ease-suave) both;\n  animation-delay: calc(var(--i, 0) * 60ms);\n  transition:\n    grid-template-rows 0.42s var(--ease-suave),\n    opacity 0.28s ease,\n    transform 0.42s var(--ease-suave);\n}\n.donacion-item-interior {\n  min-height: 0;\n  padding-bottom: 20px;\n}\n.donacion-item:last-child .donacion-item-interior { padding-bottom: 0; }\n\n.donacion-item[data-saliendo] {\n  grid-template-rows: 0fr;\n  opacity: 0;\n  transform: scale(0.98) translateY(-6px);\n  overflow: hidden;\n  pointer-events: none;\n}\n\n.vacio-donaciones {\n  text-align: center;\n  color: var(--tinta-suave);\n}\n\n.aparecer { animation: aparecer 0.4s var(--ease-suave) both; }\n\n.btn-link-reintentar {\n  background: none;\n  border: 0;\n  padding: 0;\n  font: inherit;\n  font-weight: 600;\n  color: inherit;\n  text-decoration: underline;\n  text-underline-offset: 3px;\n  cursor: pointer;\n}\n.btn-link-reintentar:focus-visible {\n  outline: 2px solid currentColor;\n  outline-offset: 3px;\n  border-radius: 4px;\n}\n\n/* ---------- Keyframes ---------- */\n@keyframes brillo {\n  from { background-position: 100vw 0; }\n  to   { background-position: -100vw 0; }\n}\n@keyframes entrar {\n  from { opacity: 0; transform: translateY(10px); }\n  to   { opacity: 1; transform: none; }\n}\n@keyframes aparecer {\n  from { opacity: 0; transform: translateY(-4px); }\n  to   { opacity: 1; transform: none; }\n}\n@keyframes latido {\n  0%   { transform: scale(1);   opacity: 0.6; }\n  100% { transform: scale(2.6); opacity: 0; }\n}\n\n/* ---------- Movimiento reducido ---------- */\n@media (prefers-reduced-motion: reduce) {\n  .esq,\n  .esq-punto::after { animation: none; }\n  .esq-tarjeta,\n  .donacion-item,\n  .aparecer,\n  .esq-estado { animation-duration: 0.01ms; animation-delay: 0ms; }\n  .donacion-item { transition-duration: 0.01ms; }\n}\n"],["STYLE",{},"/* Requiere PanelDonaciones.css (tokens --ease-suave, .esq, .esq-linea, .esq-punto, keyframes) */\n\n.stock-resumen {\n  margin-left: auto;\n  min-height: 24px;\n  display: flex;\n  align-items: center;\n  font-size: 14px;\n  color: var(--tinta-suave);\n}\n\n/* ---------- Filas esqueleto ---------- */\n.esq-fila {\n  animation: entrar 0.5s var(--ease-suave) both;\n  animation-delay: calc(var(--i, 0) * 60ms);\n}\n.esq-celda-producto {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.esq-icono { width: 20px; height: 20px; border-radius: 6px; flex-shrink: 0; }\n.esq-semaforo { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }\n.esq-input { width: 80px; height: 30px; border-radius: 8px; flex-shrink: 0; }\n.esq-boton { width: 64px; height: 30px; border-radius: 8px; flex-shrink: 0; }\n\n/* ---------- Filas reales ---------- */\n.fila-entrar {\n  animation: entrar 0.45s var(--ease-suave) both;\n  animation-delay: calc(var(--i, 0) * 35ms);\n}\n\n.fila-ajustada > td {\n  animation: destello 1.2s ease-out;\n}\n\n.btn-ajustar {\n  transition: opacity 0.2s ease;\n}\n.btn-ajustar:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n\n@keyframes destello {\n  0%   { background-color: color-mix(in srgb, var(--naranja-hover, #e8a33d) 20%, transparent); }\n  100% { background-color: transparent; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .esq-fila,\n  .fila-entrar { animation-duration: 0.01ms; animation-delay: 0ms; }\n  .fila-ajustada > td { animation: none; }\n}\n"],["STYLE",{},"@import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Jost:wght@400;500;600;700&display=swap');\n\n/* Sumá un Plato — versión 2: colores tomados del logo (verde petróleo + dorado),\n   tono más institucional de fundación. Mismos nombres de clase que la versión 1. */\n:root {\n  --verde: #1b4b43;\n  --verde-hover: #143a34;\n  --verde-suave: #e7f0ee;\n  --verde-noche: #10302b;\n  --dorado: #c8952c;\n  --dorado-hover: #b38220;\n  --dorado-suave: #f6edd9;\n  --dorado-borde: #e8d4a0;\n\n  /* nombres originales (naranja = acción de donar) */\n  --naranja: var(--dorado);\n  --naranja-hover: var(--dorado-hover);\n  --naranja-suave: var(--dorado-suave);\n\n  --papel: #ffffff;\n  --superficie: #ffffff;\n  --crema: #f7f4ec;\n  --tinta: #14211e;\n  --tinta-suave: #4d5c58;\n  --borde: #e3e6e0;\n\n  --sem-verde: #2f8f63;\n  --sem-ambar: #c98a1b;\n  --sem-rojo: #b3382c;\n\n  --fuente-titulo: 'DM Serif Display', Georgia, 'Times New Roman', serif;\n  --fuente-texto: 'Jost', system-ui, -apple-system, 'Segoe UI', Arial, sans-serif;\n  --r-sm: 8px;\n  --r-md: 14px;\n  --sombra: 0 1px 2px rgba(16, 48, 43, .05), 0 8px 24px rgba(16, 48, 43, .06);\n}\n\n* { box-sizing: border-box; }\n\nhtml { scroll-behavior: smooth; scroll-padding-top: 16px; }\n@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }\n\nbody {\n  margin: 0;\n  background: var(--papel);\n  color: var(--tinta);\n  font-family: var(--fuente-texto);\n  line-height: 1.6;\n  font-size: 17px;\n}\n\nh1, h2, h3, .font-display, .logo-nombre, .stat-num, .kpi-num {\n  font-family: var(--fuente-titulo);\n  font-weight: 400;\n  color: inherit;\n  letter-spacing: -.005em;\n}\nh1 { line-height: 1.12; }\nh2 { line-height: 1.2; }\n\na { color: var(--verde); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }\na:hover { color: var(--verde-hover); }\n\n.contenedor { max-width: 1040px; margin: 0 auto; padding: 0 20px; }\n.medida { max-width: 640px; }\n.tabular { font-variant-numeric: tabular-nums; }\n.centro { text-align: center; }\n.mt-1 { margin-top: 8px; } .mt-2 { margin-top: 16px; } .mt-3 { margin-top: 24px; }\n.mt-4 { margin-top: 32px; } .mt-6 { margin-top: 40px; } .mt-8 { margin-top: 48px; }\n.mb-2 { margin-bottom: 16px; } .mb-3 { margin-bottom: 24px; } .mb-4 { margin-bottom: 32px; }\n\nbutton { font-family: inherit; cursor: pointer; font-size: 17px; }\n\na:focus-visible, button:focus-visible {\n  outline: 2px solid var(--verde-noche);\n  outline-offset: 2px;\n  box-shadow: 0 0 0 5px rgba(200, 149, 44, .45);\n}\ninput:focus, select:focus, textarea:focus {\n  outline: 2px solid var(--verde);\n  outline-offset: 1px;\n}\n\n/* ---------- Botones ---------- */\n.btn-donar, .btn-verde, .btn-fantasma {\n  display: inline-block;\n  padding: 11px 24px;\n  border: 1.5px solid transparent;\n  border-radius: 999px;\n  font-weight: 600;\n  text-align: center;\n  text-decoration: none;\n  transition: background-color .15s, border-color .15s, color .15s;\n}\n.btn-donar { background: var(--dorado); color: var(--verde-noche); border-color: var(--dorado); }\n.btn-donar:hover { background: var(--dorado-hover); border-color: var(--dorado-hover); color: var(--verde-noche); text-decoration: none; }\n.btn-verde { background: var(--verde); color: #ffffff; border-color: var(--verde); }\n.btn-verde:hover { background: var(--verde-hover); border-color: var(--verde-hover); color: #ffffff; text-decoration: none; }\n.btn-fantasma { background: transparent; color: var(--verde); border-color: var(--verde); }\n.btn-fantasma:hover { background: var(--verde); color: #ffffff; text-decoration: none; }\nbutton:disabled { opacity: .5; cursor: default; }\n\n.ancho { width: 100%; }\n.btn-icono, .icon-boton {\n  background: var(--superficie); border: 1px solid var(--borde); border-radius: var(--r-sm);\n  padding: 4px 8px; color: var(--verde);\n}\n.btn-icono:hover, .icon-boton:hover { background: var(--verde-suave); }\n\n/* ---------- Chips y estados ---------- */\n.chip {\n  display: inline-block;\n  font-size: 13px;\n  font-weight: 600;\n  padding: 3px 12px;\n  border-radius: 999px;\n  border: 1px solid var(--borde);\n  background: var(--superficie);\n  color: var(--tinta);\n}\n.chip-urgente { background: #f8e3df; color: #8a2a20; border-color: #eec2bb; }\n.chip-suave { background: var(--dorado-suave); color: #6b4c0f; border-color: var(--dorado-borde); }\n.chip-verde { background: var(--verde-suave); color: var(--verde); border-color: #c4d8d3; }\n.chip-gris { background: #eef0eb; color: var(--tinta-suave); border-color: var(--borde); }\n\n.punto { display: inline-block; width: 10px; height: 10px; border-radius: 50%; }\n.punto-verde { background: var(--sem-verde); }\n.punto-ambar { background: var(--sem-ambar); }\n.punto-rojo { background: var(--sem-rojo); }\n.punto-neutro { background: #b9c1bd; }\n\n/* ---------- Tarjetas y grillas ---------- */\n.tarjeta { background: var(--superficie); border: 1px solid var(--borde); border-radius: var(--r-md); box-shadow: var(--sombra); }\n.tarjeta-pad { padding: 22px; }\n.tarjeta-hover { transition: border-color .15s, box-shadow .15s; }\n.tarjeta-hover:hover { border-color: var(--dorado); box-shadow: 0 2px 4px rgba(16, 48, 43, .06), 0 12px 30px rgba(16, 48, 43, .10); }\n\n.grid { display: grid; gap: 24px; }\n.grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }\n@media (min-width: 640px) {\n  .grid-2 { grid-template-columns: 1fr 1fr; }\n  .grid-3 { grid-template-columns: 1fr 1fr; }\n  .grid-4 { grid-template-columns: 1fr 1fr; }\n}\n@media (min-width: 1000px) {\n  .grid-3 { grid-template-columns: 1fr 1fr 1fr; }\n  .grid-4 { grid-template-columns: repeat(4, 1fr); }\n  .donar-grid { grid-template-columns: 1fr 320px !important; align-items: start; }\n  .merendero-grid { grid-template-columns: 320px 1fr !important; align-items: start; }\n}\n\n.progreso-riel { background: #e9ece7; border-radius: 999px; height: 8px; overflow: hidden; }\n.progreso-relleno { background: var(--dorado); height: 100%; border-radius: 999px; }\n\n/* ---------- Formularios ---------- */\n.campo {\n  width: 100%;\n  background: var(--superficie);\n  border: 1px solid #b9c4c0;\n  border-radius: var(--r-sm);\n  padding: 11px 14px;\n  font-size: 17px;\n  color: var(--tinta);\n  font-family: inherit;\n}\n.label-campo { display: block; font-weight: 600; font-size: 15px; margin-bottom: 6px; color: var(--verde-noche); }\n\n.pildora { position: relative; display: inline-block; }\n.pildora input { margin-right: 4px; }\n.pildora span {\n  display: inline-block; padding: 6px 16px; border: 1px solid #b9c4c0;\n  border-radius: 999px; cursor: pointer; background: var(--superficie);\n}\n.pildora input:checked + span { background: var(--verde); border-color: var(--verde); color: #ffffff; }\n\n.icono-circulo {\n  width: 56px; height: 56px; border-radius: 50%;\n  background: var(--dorado-suave); color: var(--verde);\n  display: flex; align-items: center; justify-content: center;\n}\n\n/* ---------- Encabezado ---------- */\n.header { border-bottom: 1px solid var(--borde); background: var(--superficie); }\n.header-inner { height: 72px; display: flex; align-items: center; justify-content: space-between; }\n.logo { display: flex; align-items: center; gap: 8px; color: var(--verde); text-decoration: none; }\n.logo:hover { color: var(--verde-hover); text-decoration: none; }\n.logo-nombre { font-size: 22px; color: var(--verde); }\n.logo img { display: block; height: 42px; width: auto; }\n@media (min-width: 768px) { .logo img { height: 52px; } }\n.nav { display: none; align-items: center; gap: 10px; }\n.nav a:not(.btn-donar):not(.btn-verde):not(.btn-fantasma) {\n  color: var(--verde); text-decoration: none; font-weight: 500; font-size: 15px;\n  padding: 6px 18px; border-radius: 999px;\n  background: transparent; border: 1px solid var(--verde);\n  transition: background-color .15s, color .15s;\n}\n.nav a:not(.btn-donar):not(.btn-verde):not(.btn-fantasma):hover {\n  background: var(--verde); color: #ffffff; text-decoration: none;\n}\n@media (min-width: 768px) { .nav { display: flex; } }\n.nav-mobile { display: flex; gap: 8px; align-items: center; }\n@media (min-width: 768px) { .nav-mobile { display: none; } }\n\n/* ---------- Portada ---------- */\n.hero { padding: 48px 0 64px; }\n.hero-grid { display: grid; gap: 36px; align-items: center; }\n@media (min-width: 768px) { .hero-grid { grid-template-columns: 1fr 1fr; gap: 56px; } }\n.hero h1 { font-size: clamp(30px, 4.2vw, 46px); margin: 14px 0 18px; color: var(--verde-noche); }\n.hero p { color: var(--tinta-suave); font-size: 19px; max-width: 34em; }\n\n/* La fotografía, con un marco dorado desplazado */\n.hero-imagen { position: relative; isolation: isolate; }\n.hero-halo { display: none; }\n@media (min-width: 768px) {\n  .hero-imagen::before {\n    content: \"\"; position: absolute; inset: 14px -14px -14px 14px;\n    border: 2px solid var(--dorado); border-radius: 18px; z-index: -1;\n  }\n}\n.hero-foto { border-radius: var(--r-md); overflow: hidden; background: var(--verde-suave); }\n.hero-foto img, .hero-foto svg {\n  display: block; width: 100%; height: 100%;\n  aspect-ratio: 4 / 3; object-fit: cover;\n}\n\n.seccion { padding: 56px 0; }\n.seccion-clara { background: var(--crema); }\n.seccion h2 { font-size: clamp(26px, 3vw, 34px); color: var(--verde-noche); }\n.seccion h3 { font-size: 21px; color: var(--verde-noche); }\n.seccion p { color: var(--tinta-suave); }\n\n.banda { background: var(--verde-noche); color: #ffffff; padding: 48px 0; }\n.stat-num { font-size: 42px; color: #e3b54f; }\n\n.franja-transparencia {\n  background: var(--dorado-suave); border: 1px solid var(--dorado-borde); border-radius: var(--r-md);\n  padding: 20px 24px; text-align: center;\n}\n.franja-transparencia p { margin: 0; color: var(--verde-noche); }\n\n/* ---------- Pie ---------- */\n.footer { margin-top: 64px; background: var(--verde-noche); color: #ffffff; border-top: 3px solid var(--dorado); }\n.footer-grid { display: grid; gap: 28px; padding: 44px 0; }\n@media (min-width: 768px) { .footer-grid { grid-template-columns: repeat(4, 1fr); } }\n.footer h4 { margin: 0 0 8px; font-family: var(--fuente-texto); font-weight: 600; color: #ffffff; }\n.footer p { color: rgba(255, 255, 255, .78); font-size: 15px; margin: 4px 0; }\n.footer a { color: #ffffff; }\n\n/* ---------- Avisos ---------- */\n.alerta {\n  border: 1px solid var(--borde); border-radius: var(--r-sm);\n  padding: 12px 16px; font-size: 16px; margin-bottom: 16px;\n  background: var(--superficie); color: var(--tinta);\n}\n.alerta-ok { background: var(--verde-suave); border-color: #c4d8d3; color: var(--verde-noche); }\n.alerta-error { background: #f8e3df; border-color: #eec2bb; color: #7a241b; }\n.alerta-info { background: var(--dorado-suave); border-color: var(--dorado-borde); color: #5e420b; }\n\n/* ---------- Panel (admin / merendero) ---------- */\n.panel { display: flex; min-height: 100vh; }\n.sidebar {\n  position: fixed; top: 0; left: 0; z-index: 40; height: 100vh; width: 248px;\n  background: var(--verde-noche); color: #ffffff; display: flex; flex-direction: column;\n  transform: translateX(-100%); transition: transform .2s ease;\n}\n.sidebar.abierto { transform: translateX(0); }\n@media (min-width: 768px) { .sidebar { position: sticky; transform: none; } }\n.sidebar-logo {\n  display: block;\n  background: #fff;\n  border-radius: 12px;\n  padding: 8px 12px;\n}\n\n.sidebar-logo img {\n  display: block;\n  width: 100%;\n  height: auto;\n  max-height: 56px;\n  object-fit: contain;\n}\n\n.sidebar-top {\n  padding: 20px 16px;\n}\n.sidebar-nav { flex: 1; overflow-y: auto; padding: 12px 8px; display: flex; flex-direction: column; gap: 2px; }\n.sidebar-link {\n  display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: var(--r-sm);\n  color: rgba(255, 255, 255, .85); font-size: 16px; border: none; background: none;\n  text-align: left; cursor: pointer; text-decoration: none; width: 100%;\n}\n.sidebar-link:hover { background: rgba(255, 255, 255, .1); color: #ffffff; text-decoration: none; }\n.sidebar-link.activo { background: rgba(255, 255, 255, .12); color: #ffffff; font-weight: 600; box-shadow: inset 3px 0 0 var(--dorado); }\n.sidebar-badge { margin-left: auto; background: var(--dorado); color: var(--verde-noche); font-size: 12px; font-weight: 700; border-radius: 999px; padding: 0 8px; }\n.sidebar-bottom { padding: 8px; border-top: 1px solid rgba(255, 255, 255, .15); }\n.sidebar-backdrop { position: fixed; inset: 0; background: rgba(0, 0, 0, .5); z-index: 30; }\n@media (min-width: 768px) { .sidebar-backdrop { display: none; } }\n\n.panel-main { flex: 1; min-width: 0; background: #fafaf7; }\n.panel-top { height: 72px; display: flex; align-items: center; gap: 12px; padding: 0 20px; border-bottom: 1px solid var(--borde); background: var(--superficie); }\n.panel-top .icon-boton { display: inline-flex; }\n@media (min-width: 768px) { .panel-top .icon-boton { display: none; } }\n.panel-top h1 { font-size: 26px; margin: 0; color: var(--verde-noche); }\n.panel-contenido { padding: 24px 20px; }\n\n.kpi { background: var(--superficie); border: 1px solid var(--borde); border-radius: var(--r-md); padding: 22px; box-shadow: var(--sombra); }\n.kpi-num { font-size: 34px; color: var(--verde); }\n\n.tabla { width: 100%; border-collapse: collapse; }\n.tabla th { text-align: left; font-size: 14px; font-weight: 600; color: var(--verde); padding: 10px 8px; border-bottom: 2px solid var(--verde); }\n.tabla td { padding: 12px 8px; border-bottom: 1px solid var(--borde); font-size: 16px; vertical-align: middle; }\n.tabla tbody tr:hover { background: var(--crema); }\n.tabla-scroll { overflow-x: auto; }\n\n.reveal { opacity: 1; }\n\n.check-svg { width: 72px; height: 72px; }\n.check-svg circle { stroke: var(--verde); stroke-width: 3; fill: var(--verde-suave); }\n.check-svg path { stroke: var(--verde); stroke-width: 4; fill: none; stroke-linecap: round; stroke-linejoin: round; }\n\n.timeline { display: flex; align-items: center; margin-bottom: 16px; }\n.timeline-paso { display: flex; flex-direction: column; align-items: center; text-align: center; width: 72px; flex-shrink: 0; }\n.timeline-circulo { width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #ffffff; font-size: 12px; font-weight: 700; }\n.timeline-label { font-size: 12px; margin-top: 4px; color: var(--tinta-suave); }\n.timeline-linea { flex: 1; height: 2px; margin-top: -20px; }\n\n.cargando { display: inline-block; width: 32px; height: 32px; border: 3px solid var(--borde); border-top-color: var(--verde); border-radius: 50%; animation: girar .8s linear infinite; }\n@keyframes girar { to { transform: rotate(360deg); } }\n@media (prefers-reduced-motion: reduce) {\n  .cargando { animation-duration: 2.4s; }\n  .sidebar, .btn-donar, .btn-verde, .btn-fantasma, .tarjeta-hover { transition: none; }\n}\n\n/* =====================================================================\n   Refinamientos v3 — mismo sistema de la v2, con acabado más profesional\n   ===================================================================== */\n::selection { background: var(--dorado-borde); color: var(--verde-noche); }\nhtml { scroll-padding-top: 92px; }\nbody { -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }\nh1, h2, h3 { text-wrap: balance; }\np, li { text-wrap: pretty; }\n\n/* Encabezado fijo con leve transparencia */\n.header {\n  position: sticky; top: 0; z-index: 20;\n  background: rgba(255, 255, 255, .92);\n  -webkit-backdrop-filter: saturate(1.4) blur(10px);\n  backdrop-filter: saturate(1.4) blur(10px);\n}\n\n/* Fondo suave detrás de la portada */\nmain { background: linear-gradient(180deg, #eef5f2 0, #ffffff 640px); }\n\n/* Corrección: .hero y .seccion también son .contenedor, no deben perder el margen lateral */\n.hero { padding-top: 64px; padding-bottom: 80px; padding-left: 20px; padding-right: 20px; }\n.seccion { padding-top: 64px; padding-bottom: 64px; }\n.contenedor.seccion { padding-left: 20px; padding-right: 20px; }\n\n/* Portada */\n.hero h1 { font-size: clamp(32px, 4.6vw, 54px); line-height: 1.08; letter-spacing: -.015em; }\n.hero .chip-suave { padding: 5px 14px 5px 12px; }\n.hero .chip-suave::before {\n  content: \"\"; display: inline-block; width: 7px; height: 7px; border-radius: 50%;\n  background: var(--dorado); margin-right: 9px; vertical-align: 1px;\n}\n.hero-foto { border-radius: 18px; box-shadow: 0 30px 50px -28px rgba(16, 48, 43, .45); }\n@media (min-width: 768px) { .hero-imagen::before { border-radius: 22px; } }\n\n/* Títulos de sección con detalle dorado */\n.seccion h2::before {\n  content: \"\"; display: block; width: 44px; height: 3px; border-radius: 2px;\n  background: var(--dorado); margin-bottom: 18px;\n}\n.seccion h2.centro::before { margin-left: auto; margin-right: auto; }\n\n/* Botones */\n.btn-donar, .btn-verde, .btn-fantasma {\n  padding: 12px 28px; letter-spacing: .01em;\n  transition: background-color .15s, border-color .15s, color .15s, transform .15s, box-shadow .15s;\n}\n.btn-donar { box-shadow: 0 8px 18px -8px rgba(200, 149, 44, .75); }\n.btn-verde { box-shadow: 0 8px 18px -10px rgba(16, 48, 43, .7); }\n.btn-donar:hover, .btn-verde:hover { transform: translateY(-1px); }\n\n/* Tarjetas, íconos y progreso */\n.tarjeta, .kpi { border-radius: 16px; }\n.tarjeta-pad { padding: 24px; }\n.tarjeta-hover { transition: border-color .2s, box-shadow .2s, transform .2s; }\n.tarjeta-hover:hover { transform: translateY(-3px); }\n.icono-circulo { box-shadow: 0 0 0 6px rgba(200, 149, 44, .14); }\n.progreso-relleno { background: linear-gradient(90deg, var(--dorado), #dcae4a); }\n\n/* Formularios */\n.campo { transition: border-color .15s, box-shadow .15s; }\n.campo:focus { outline: none; border-color: var(--verde); box-shadow: 0 0 0 4px rgba(27, 75, 67, .14); }\n\n/* Banda de estadísticas */\n.banda { background: linear-gradient(135deg, #0c2622 0%, #163e37 100%); padding: 72px 0; }\n.stat-num { font-size: clamp(38px, 5vw, 52px); line-height: 1.1; }\n@media (min-width: 1000px) { .banda .grid-3 > div + div { border-left: 1px solid rgba(255, 255, 255, .16); } }\n.banda blockquote { border-top: 1px solid rgba(255, 255, 255, .16); padding-top: 44px; }\n.banda blockquote p { font-size: clamp(20px, 2.4vw, 26px) !important; line-height: 1.35; }\n\n/* Pie */\n.footer a { text-decoration-color: rgba(255, 255, 255, .4); }\n.footer a:hover { color: var(--dorado-borde); }\n\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after { transition: none !important; }\n  .btn-donar:hover, .btn-verde:hover, .tarjeta-hover:hover { transform: none; }\n}\n\n/* Logo a color arriba del menú lateral del panel.\n   El logo tiene fondo blanco, así que esa franja va en blanco para que quede prolijo. */\n/* Franja del logo y barra superior del panel: misma altura y misma línea dorada,\n   así forman una sola banda blanca de punta a punta. */\n.sidebar-top, .panel-top { height: 88px; box-sizing: border-box; background: #ffffff; border-bottom: 3px solid var(--dorado); }\n.sidebar-top { padding: 0 16px; display: flex; align-items: center; justify-content: center; }\n.sidebar-logo { display: block; line-height: 0; text-decoration: none; background: none; padding: 0; border-radius: 0; }\n.sidebar-logo img { display: block; height: 52px; width: auto; max-width: 100%; max-height: none; }\n"]],"\n",["BODY",{},"\n  ",["DIV",{"id":"root"},["HEADER",{"class":"header"},["DIV",{"class":"contenedor header-inner"},["A",{"class":"logo","href":"/"},["IMG",{"__playwright_current_src__":"http://localhost:5173/logo.jpg","src":"/